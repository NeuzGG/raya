# Copy this file to bot/.env and fill it in. Never commit bot/.env.

# ---- Discord ----
# Developer Portal > your app > Bot > Reset Token
DISCORD_TOKEN=your-bot-token-here
# Optional: a test server where `npm run deploy` registers commands instantly
DEV_GUILD_ID=

# ---- Lavalink v4 ----
LAVALINK_HOST=localhost
LAVALINK_PORT=2333
LAVALINK_PASSWORD=youshallnotpass
LAVALINK_SECURE=false
# More than one node? Use JSON instead of the four lines above:
# LAVALINK_NODES=[{"name":"eu","host":"eu.example.com","port":443,"password":"...","secure":true}]

# ---- Music ----
# youtube, youtubemusic, soundcloud, or spotify / applemusic / deezer with LavaSrc
SEARCH_SOURCE=youtube
DEFAULT_VOLUME=80
# Seconds before leaving an empty voice channel, and after the queue ends (0 = never)
LEAVE_WHEN_EMPTY_AFTER=60
LEAVE_AFTER_QUEUE_END=180
MAX_QUEUE_SIZE=1000
# Show the song as the voice channel status (needs the "Set Voice Channel Status" permission)
VOICE_STATUS=true

# ---- /help ----
# Optional one-off notice at the top of /help (otherwise src/announcements.js is used)
ANNOUNCEMENT=
# Links shown as buttons
WEBSITE_URL=https://neuzgg.github.io/raya/
GITHUB_URL=https://github.com/neuzgg/raya
SUPPORT_URL=

# ---- Other ----
SNAPSHOT_FILE=data/snapshot.json
# Per-server settings: the /setup channels and the DJ role
SETTINGS_FILE=data/guilds.json
RAYA_DEBUG=false
