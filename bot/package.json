{
  "name": "raya-bot",
  "version": "1.0.0",
  "private": true,
  "description": "The official Raya music bot: raya.js + discord.js Components V2, with a live player you control with buttons.",
  "author": "neuzgg",
  "license": "MIT",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "deploy": "node scripts/deploy-commands.js",
    "pretest": "npm --prefix .. run pretest",
    "test": "node --test --test-reporter=spec \"test/**/*.test.js\""
  },
  "engines": {
    "node": ">=20.12.0"
  },
  "dependencies": {
    "discord.js": "^14.27.0",
    "raya.js": "file:.."
  }
}
