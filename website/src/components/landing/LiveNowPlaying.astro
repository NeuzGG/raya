---
import { SITE } from '../../site.mjs';
import { link } from '../../utils/links';

const feedUrl: string = (import.meta.env.PUBLIC_LIVE_FEED_URL || SITE.liveFeed || '').trim();
---

{
  feedUrl && (
    <section class="section live" id="live" data-live-feed data-url={feedUrl}>
      <div class="container">
        <header class="section-head" data-reveal>
          <span class="eyebrow live-eyebrow">
            <span class="rec" aria-hidden="true" />
            Live
          </span>
          <h2>
            Now playing <span class="gradient-text">live</span>
          </h2>
          <p>Straight from the bot, updated the moment a song starts, pauses or ends.</p>
        </header>

        <article class="bot is-loading" data-bot data-state="connecting" data-reveal>
          <div class="backdrop" data-backdrop aria-hidden="true" />

          <div class="identity">
            <div class="avatar-wrap">
              <span class="avatar" data-avatar />
              <span class="presence" aria-hidden="true" />
            </div>
            <div class="who">
              <strong class="bot-name" data-bot-name>
                <span class="skeleton" />
              </strong>
              <span class="bot-status" data-bot-status role="status">
                Connecting…
              </span>
            </div>
            <a class="invite" data-invite hidden target="_blank" rel="noopener noreferrer">
              Add to Discord
            </a>
          </div>

          <div class="track" data-track hidden>
            <div class="cover" data-cover>
              <span class="cover-fallback" data-cover-fallback />
              <span class="bars" aria-hidden="true">
                <i />
                <i />
                <i />
                <i />
              </span>
            </div>
            <div class="info">
              <span class="label" data-label>
                Now playing
              </span>
              <a class="title" data-title target="_blank" rel="noopener noreferrer" />
              <span class="author" data-author />
              <div class="progress">
                <i class="fill" data-fill />
              </div>
              <div class="meta">
                <span class="time" data-time />
                <span class="badge source" data-source />
              </div>
            </div>
          </div>

          <div class="message" data-idle hidden>
            <svg class="vinyl" viewBox="0 0 120 120" aria-hidden="true">
              <circle cx="60" cy="60" r="56" />
              <circle cx="60" cy="60" r="40" class="groove" />
              <circle cx="60" cy="60" r="28" class="groove" />
              <circle cx="60" cy="60" r="14" class="label-dot" />
              <circle cx="60" cy="60" r="3" class="hole" />
            </svg>
            <div>
              <strong>Not playing anything right now</strong>
              <span>This updates by itself when a song starts.</span>
            </div>
          </div>

          <div class="message" data-offline hidden>
            <div>
              <strong>The bot is offline right now</strong>
              <span>It reconnects automatically when the bot is back.</span>
            </div>
          </div>
        </article>

        <div class="grid" data-grid hidden />

        <p class="note" data-reveal>
          Only the song is shared: no server names or usernames.{' '}
          <a href={link('guides/live-now-playing/')}>Connect your own bot →</a>
        </p>
      </div>
    </section>
  )
}

<script>
  import { mountLiveFeed } from '../../scripts/live-feed';
  document.querySelectorAll<HTMLElement>('[data-live-feed]').forEach(mountLiveFeed);
</script>

<style>
  .live {
    background: radial-gradient(ellipse 55% 45% at 50% 0%, color-mix(in srgb, var(--rose) 9%, transparent), transparent 70%);
  }
  .live-eyebrow {
    color: var(--red);
  }
  .rec {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--red);
    animation: blink 1.4s ease-in-out infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0.3;
    }
  }

  /* ---------- Bot card ---------- */
  .bot {
    --state: var(--amber);
    position: relative;
    max-width: 860px;
    margin: 0 auto;
    padding: clamp(1.1rem, 3vw, 1.8rem);
    border-radius: 26px;
    border: 1px solid var(--border-strong);
    background: color-mix(in srgb, var(--surface) 88%, transparent);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
    isolation: isolate;
  }
  .bot[data-state='playing'],
  .bot[data-state='paused'],
  .bot[data-state='idle'] {
    --state: var(--mint);
  }
  .bot[data-state='offline'] {
    --state: var(--red);
  }
  .backdrop {
    position: absolute;
    inset: -30%;
    z-index: -1;
    opacity: 0;
    transition: opacity 0.8s;
  }
  .bot[data-state='playing'] .backdrop,
  .bot[data-state='paused'] .backdrop {
    opacity: 0.35;
  }
  :global(:root[data-theme='light']) .bot[data-state='playing'] .backdrop,
  :global(:root[data-theme='light']) .bot[data-state='paused'] .backdrop {
    opacity: 0.22;
  }
  .backdrop :global(.backdrop-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: blur(60px) saturate(1.6);
  }

  .identity {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }
  .avatar-wrap {
    position: relative;
    flex: none;
  }
  .avatar {
    --h: 20;
    position: relative;
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    overflow: hidden;
    background: linear-gradient(135deg, hsl(var(--h) 85% 60%), hsl(calc(var(--h) + 50) 80% 45%));
  }
  .avatar::after {
    content: attr(data-initial);
    color: #fff;
    font-family: var(--display);
    font-weight: 800;
    font-size: 1.4rem;
  }
  .avatar :global(.avatar-img) {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .presence {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--state);
    border: 3px solid var(--surface);
    transition: background 0.3s;
  }
  .bot[data-state='playing'] .presence::after {
    content: '';
    position: absolute;
    inset: -5px;
    border-radius: 50%;
    border: 2px solid var(--mint);
    animation: ping 1.8s ease-out infinite;
  }
  @keyframes ping {
    from {
      transform: scale(0.5);
      opacity: 0.9;
    }
    to {
      transform: scale(1.5);
      opacity: 0;
    }
  }
  .who {
    display: grid;
    min-width: 0;
  }
  .bot-name {
    font-family: var(--display);
    font-size: 1.25rem;
    letter-spacing: -0.02em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .bot-status {
    font-size: 0.85rem;
    color: var(--muted);
  }
  .invite {
    margin-left: auto;
    flex: none;
    padding: 0.5rem 0.95rem;
    border-radius: 999px;
    background: #5865f2;
    color: #fff;
    font-size: 0.85rem;
    font-weight: 600;
    transition: transform 0.25s var(--ease-out), box-shadow 0.25s;
  }
  .invite:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 26px -12px #5865f2;
  }

  /* Loading skeleton: no fake data while connecting */
  .skeleton,
  .is-loading .avatar {
    background: linear-gradient(90deg, var(--surface-2) 25%, var(--surface-3) 50%, var(--surface-2) 75%);
    background-size: 200% 100%;
    animation: shimmer 1.3s linear infinite;
  }
  .skeleton {
    display: block;
    width: 140px;
    height: 1.1rem;
    border-radius: 6px;
  }
  .is-loading .avatar::after {
    content: '';
  }
  @keyframes shimmer {
    to {
      background-position: -200% 0;
    }
  }

  .track {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: clamp(1rem, 3vw, 1.6rem);
    align-items: center;
    margin-top: 1.3rem;
    padding-top: 1.3rem;
    border-top: 1px solid var(--border);
  }
  .cover {
    --h: 20;
    position: relative;
    width: clamp(110px, 22vw, 168px);
    aspect-ratio: 1;
    border-radius: 18px;
    overflow: hidden;
    background: linear-gradient(135deg, hsl(var(--h) 85% 62%), hsl(calc(var(--h) + 50) 80% 45%));
    box-shadow: 0 20px 44px -18px rgba(0, 0, 0, 0.6);
  }
  .cover :global(.cover-img) {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .cover-fallback {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: #fff;
    font-family: var(--display);
    font-weight: 800;
    font-size: 3rem;
  }
  .bars {
    position: absolute;
    right: 8px;
    top: 8px;
    z-index: 2;
    display: flex;
    align-items: flex-end;
    gap: 3px;
    height: 22px;
    padding: 4px 6px;
    border-radius: 7px;
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(4px);
  }
  .bars i {
    width: 3px;
    height: 100%;
    border-radius: 2px;
    background: #fff;
    transform-origin: bottom;
    animation: eq 0.8s ease-in-out infinite alternate;
  }
  .bars i:nth-child(2) {
    animation-delay: -0.25s;
  }
  .bars i:nth-child(3) {
    animation-delay: -0.5s;
  }
  .bars i:nth-child(4) {
    animation-delay: -0.15s;
  }
  .bot[data-state='paused'] .bars i {
    animation: none;
    transform: scaleY(0.25);
  }
  @keyframes eq {
    from {
      transform: scaleY(0.25);
    }
  }
  .info {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .label {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--coral);
  }
  .bot[data-state='paused'] .label {
    color: var(--amber);
  }
  .title {
    margin-top: 0.2rem;
    font-family: var(--display);
    font-size: clamp(1.35rem, 3.4vw, 2rem);
    font-weight: 750;
    line-height: 1.15;
    letter-spacing: -0.02em;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .title[href]:hover {
    text-decoration: underline;
    text-decoration-color: var(--coral);
  }
  .author {
    margin-top: 0.15rem;
    color: var(--muted);
    font-size: 1rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .progress {
    height: 6px;
    margin-top: 1rem;
    border-radius: 6px;
    background: color-mix(in srgb, var(--surface-3) 80%, transparent);
    overflow: hidden;
  }
  .fill {
    display: block;
    width: 0;
    height: 100%;
    border-radius: inherit;
    background: var(--grad);
    transition: width 0.3s linear;
  }
  .bot[data-state='paused'] .fill {
    background: var(--faint);
  }
  .meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }
  .time {
    font-family: var(--mono);
    font-size: 0.8rem;
    color: var(--faint);
    font-variant-numeric: tabular-nums;
  }
  .badge {
    padding: 0.08rem 0.5rem;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--muted);
    background: var(--surface-2);
  }
  .bot :global(.src-spotify),
  .grid :global(.src-spotify) {
    color: #1ed760;
    background: rgba(30, 215, 96, 0.12);
  }
  .bot :global(.src-youtube),
  .grid :global(.src-youtube) {
    color: #ff5a5a;
    background: rgba(255, 90, 90, 0.12);
  }
  .bot :global(.src-soundcloud),
  .grid :global(.src-soundcloud) {
    color: #ff8a3d;
    background: rgba(255, 138, 61, 0.12);
  }
  .bot:global(.swap) .cover,
  .bot:global(.swap) .title,
  .bot:global(.swap) .author {
    animation: swap 0.6s var(--ease-out);
  }
  @keyframes swap {
    from {
      opacity: 0;
      transform: translateY(10px);
      filter: blur(4px);
    }
  }
  .message {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 1.3rem;
    padding-top: 1.3rem;
    border-top: 1px solid var(--border);
    color: var(--muted);
  }
  .message div {
    display: grid;
  }
  .message strong {
    color: var(--text);
  }
  .vinyl {
    flex: none;
    width: 64px;
    animation: spin 6s linear infinite;
  }
  .vinyl circle {
    fill: var(--surface-3);
  }
  .vinyl .groove {
    fill: none;
    stroke: var(--border-strong);
  }
  .vinyl .label-dot {
    fill: var(--coral);
  }
  .vinyl .hole {
    fill: var(--bg);
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
  .bot[data-state='offline'] .avatar {
    filter: grayscale(1);
    opacity: 0.6;
  }

  /* ---------- Optional server cards ---------- */
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: 12px;
    max-width: 860px;
    margin: 14px auto 0;
  }
  .grid :global(.live-card) {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr);
    gap: 0.8rem;
    padding: 0.8rem;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: var(--surface);
  }
  .grid :global(.live-card.enter) {
    animation: swap 0.5s var(--ease-out);
  }
  .grid :global(.art) {
    --h: 20;
    position: relative;
    width: 64px;
    height: 64px;
    border-radius: 12px;
    overflow: hidden;
    background: linear-gradient(135deg, hsl(var(--h) 85% 62%), hsl(calc(var(--h) + 50) 80% 45%));
  }
  .grid :global(.art-img),
  .grid :global(.icon-img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .grid :global(.art-fallback) {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: #fff;
    font-weight: 800;
    font-size: 1.4rem;
  }
  .grid :global(.body) {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .grid :global(.title) {
    font-weight: 700;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .grid :global(.author),
  .grid :global(.server-name) {
    font-size: 0.8rem;
    color: var(--muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .grid :global(.server) {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }
  .grid :global(.icon) {
    --h: 200;
    position: relative;
    display: grid;
    place-items: center;
    width: 16px;
    height: 16px;
    border-radius: 4px;
    overflow: hidden;
    background: hsl(var(--h) 60% 50%);
    color: #fff;
    font-size: 0.55rem;
    font-weight: 700;
  }
  .grid :global(.progress) {
    margin-top: auto;
    height: 3px;
    border-radius: 3px;
    background: var(--surface-3);
    overflow: hidden;
  }
  .grid :global(.fill) {
    display: block;
    width: 0;
    height: 100%;
    background: var(--grad);
  }
  .grid :global(.is-paused .fill) {
    background: var(--faint);
  }
  .grid :global(.meta) {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 0.3rem;
  }
  .grid :global(.time) {
    font-family: var(--mono);
    font-size: 0.7rem;
    color: var(--faint);
  }
  .grid :global(.badges) {
    display: flex;
    gap: 0.2rem;
  }
  .grid :global(.badge) {
    padding: 0.02rem 0.4rem;
    border-radius: 999px;
    font-size: 0.62rem;
    font-weight: 600;
    color: var(--muted);
    background: var(--surface-2);
  }
  .grid :global(.badge.paused) {
    color: var(--amber);
  }

  .note {
    margin: 1.4rem 0 0;
    text-align: center;
    font-size: 0.9rem;
    color: var(--faint);
  }
  .note a {
    font-weight: 600;
    color: var(--coral);
  }
  @media (max-width: 560px) {
    .track {
      grid-template-columns: minmax(0, 1fr);
      justify-items: start;
    }
    .cover {
      width: 100%;
      max-width: 220px;
    }
    .identity {
      flex-wrap: wrap;
    }
    .invite {
      margin-left: 0;
    }
  }
</style>
