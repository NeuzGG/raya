---
import { link } from '../../utils/links';

const calls = ["player.setVolume(80)", 'player.pause()', 'player.filters.nightcore()', "player.filters.bassBoost('low')"];
const perks = [
  ['Same-tick batching', 'Changes made together go out as one PATCH, still in order.'],
  ['Local track decoding', 'decodeTrack() reads the binary track format without calling Lavalink.'],
  ['Search cache and de-dupe', 'Repeated or simultaneous searches reuse one request.'],
  ['No per-player polling', 'Position is calculated when you read it, with no timer per guild.'],
];
---

<section class="section batching" id="performance">
  <div class="container split">
    <div class="copy" data-reveal>
      <span class="eyebrow">Fast by default</span>
      <h2>Four calls. <span class="gradient-text">One request.</span></h2>
      <p class="lead">
        Most clients send a request per method call. Raya collects what you change in the same tick and sends it
        together, in order, so bots with hundreds of guilds stay light on their Lavalink nodes.
      </p>
      <ul class="perks">
        {
          perks.map(([title, text], i) => (
            <li data-reveal style={`--delay: ${0.1 + i * 0.07}s`}>
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="m5 12 5 5 9-10" />
              </svg>
              <div>
                <strong>{title}</strong>
                <span>{text}</span>
              </div>
            </li>
          ))
        }
      </ul>
      <a class="more" href={link('guides/filters/')}>See batching in the filters guide →</a>
    </div>

    <div class="viz panel" data-batching data-reveal style="--delay: 0.1s">
      <div class="viz-head">
        <div class="mode" role="tablist" aria-label="Compare">
          <button type="button" role="tab" aria-selected="true" data-mode="raya">With Raya</button>
          <button type="button" role="tab" aria-selected="false" data-mode="naive">One request per call</button>
        </div>
        <button type="button" class="replay" data-replay aria-label="Replay animation">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12a8 8 0 1 0 2.4-5.7L4 8.5M4 4v4.5h4.5" /></svg>
        </button>
      </div>

      <div class="lane">
        <div class="calls">
          {calls.map((call) => <code class="call" data-call>{call}</code>)}
        </div>
        <div class="wire" data-wire>
          <span class="tick" data-tick>same tick</span>
        </div>
        <div class="lavalink" data-lavalink>
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="7" rx="2" /><rect x="3" y="13" width="18" height="7" rx="2" /><path d="M7 7.5h.01M7 16.5h.01" /></svg>
          <strong>Lavalink</strong>
          <span data-received>0 requests</span>
        </div>
      </div>

      <pre class="payload" data-payload>PATCH /v4/sessions/:id/players/:guild
{"{"}
  "volume": 80,
  "paused": true,
  "filters": {"{"} "timescale": {"{"}…{"}"}, "equalizer": [ … ] {"}"}
{"}"}</pre>

      <div class="counters">
        <div><span data-count-calls>0</span><small>method calls</small></div>
        <div><span data-count-requests>0</span><small>HTTP requests</small></div>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-batching]').forEach((root) => {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const calls = [...root.querySelectorAll<HTMLElement>('[data-call]')];
    const wire = root.querySelector<HTMLElement>('[data-wire]')!;
    const lavalink = root.querySelector<HTMLElement>('[data-lavalink]')!;
    const received = root.querySelector<HTMLElement>('[data-received]')!;
    const payload = root.querySelector<HTMLElement>('[data-payload]')!;
    const tick = root.querySelector<HTMLElement>('[data-tick]')!;
    const countCalls = root.querySelector<HTMLElement>('[data-count-calls]')!;
    const countRequests = root.querySelector<HTMLElement>('[data-count-requests]')!;
    let mode: 'raya' | 'naive' = 'raya';
    let run = 0;
    const sleep = (ms: number) => new Promise((r) => setTimeout(r, reduce ? 0 : ms));

    const packet = (label: string) => {
      const el = document.createElement('span');
      el.className = 'packet';
      el.textContent = label;
      wire.appendChild(el);
      return el;
    };

    async function fly(el: HTMLElement) {
      if (reduce) return el.remove();
      await el.animate(
        [
          { left: '0%', opacity: 0, transform: 'translate(0, -50%) scale(0.7)' },
          { opacity: 1, offset: 0.15 },
          { left: '100%', opacity: 1, transform: 'translate(-100%, -50%) scale(1)' },
        ],
        { duration: 900, easing: 'cubic-bezier(.5,0,.3,1)', fill: 'forwards' },
      ).finished;
      el.remove();
      lavalink.animate([{ transform: 'scale(1.06)' }, { transform: 'scale(1)' }], { duration: 350, easing: 'ease-out' });
    }

    async function play() {
      const id = ++run;
      root.dataset.mode = mode;
      calls.forEach((c) => c.classList.remove('on', 'sent'));
      payload.classList.remove('show');
      tick.classList.remove('show');
      countCalls.textContent = '0';
      countRequests.textContent = '0';
      received.textContent = '0 requests';
      wire.querySelectorAll('.packet').forEach((p) => p.remove());
      let requests = 0;
      await sleep(300);

      for (let i = 0; i < calls.length; i++) {
        if (id !== run) return;
        calls[i]!.classList.add('on');
        countCalls.textContent = String(i + 1);
        if (mode === 'naive') {
          void fly(packet('PATCH')).then(() => {
            if (id !== run) return;
            requests++;
            countRequests.textContent = String(requests);
            received.textContent = `${requests} request${requests === 1 ? '' : 's'}`;
          });
          await sleep(260);
        } else {
          await sleep(140);
        }
      }
      if (mode === 'raya') {
        tick.classList.add('show');
        await sleep(450);
        if (id !== run) return;
        calls.forEach((c) => c.classList.add('sent'));
        await fly(packet('1 × PATCH'));
        if (id !== run) return;
        countRequests.textContent = '1';
        received.textContent = '1 request';
        payload.classList.add('show');
      }
    }

    root.querySelectorAll<HTMLButtonElement>('[data-mode]').forEach((button) =>
      button.addEventListener('click', () => {
        mode = button.dataset.mode as 'raya' | 'naive';
        root.querySelectorAll('[data-mode]').forEach((b) => b.setAttribute('aria-selected', String(b === button)));
        void play();
      }),
    );
    root.querySelector('[data-replay]')!.addEventListener('click', () => void play());

    const observer = new IntersectionObserver(
      ([entry]) => {
        if (!entry!.isIntersecting) return;
        observer.disconnect();
        void play();
      },
      { threshold: 0.5 },
    );
    observer.observe(root);
  });
</script>

<style>
  .batching {
    background: var(--bg-2);
    border-block: 1px solid var(--border);
  }
  .split {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
  }
  h2 {
    margin: 0.9rem 0 0.8rem;
    font-family: var(--display);
    font-size: clamp(2rem, 4.5vw, 3.1rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
  }
  .lead {
    margin: 0 0 1.4rem;
    color: var(--muted);
    font-size: 1.05rem;
  }
  .perks {
    list-style: none;
    margin: 0 0 1.3rem;
    padding: 0;
    display: grid;
    gap: 0.8rem;
  }
  .perks li {
    display: flex;
    gap: 0.75rem;
  }
  .perks svg {
    flex: none;
    width: 22px;
    height: 22px;
    padding: 3px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--mint) 15%, transparent);
    fill: none;
    stroke: var(--mint);
    stroke-width: 2.5;
  }
  .perks strong {
    display: block;
    font-size: 0.98rem;
  }
  .perks span {
    color: var(--muted);
    font-size: 0.92rem;
  }
  .more {
    font-weight: 600;
    color: var(--coral);
  }
  .viz {
    padding: 1.1rem;
  }
  .viz-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
    margin-bottom: 1.1rem;
  }
  .mode {
    display: inline-flex;
    padding: 3px;
    border-radius: 999px;
    background: var(--surface-2);
    border: 1px solid var(--border);
  }
  .mode button {
    padding: 0.35rem 0.8rem;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--muted);
    font-size: 0.8rem;
    font-weight: 600;
    transition: background 0.25s, color 0.25s;
  }
  .mode button[aria-selected='true'] {
    background: var(--grad);
    color: #fff;
  }
  .replay {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 1px solid var(--border-strong);
    background: transparent;
    color: var(--muted);
    transition: transform 0.5s var(--ease-out), color 0.2s;
  }
  .replay:hover {
    color: var(--text);
    transform: rotate(-180deg);
  }
  .replay svg {
    width: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
  }
  .lane {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(60px, 0.8fr) auto;
    align-items: center;
    gap: 0.6rem;
  }
  .calls {
    display: grid;
    gap: 0.45rem;
  }
  .call {
    display: block;
    padding: 0.45rem 0.65rem;
    border-radius: 9px;
    border: 1px solid var(--border);
    background: var(--surface-2);
    font-family: var(--mono);
    font-size: 0.74rem;
    color: var(--tok-fn);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    opacity: 0.35;
    transform: translateX(-8px);
    transition: opacity 0.35s, transform 0.45s var(--ease-out), border-color 0.3s, filter 0.4s;
  }
  .call.on {
    opacity: 1;
    transform: none;
    border-color: color-mix(in srgb, var(--coral) 45%, var(--border));
  }
  [data-mode='raya'] .call.sent {
    transform: translateX(14px) scale(0.97);
    filter: saturate(0.4);
    opacity: 0.55;
  }
  .wire {
    position: relative;
    height: 2px;
    background: repeating-linear-gradient(90deg, var(--border-strong) 0 6px, transparent 6px 12px);
  }
  .tick {
    position: absolute;
    left: 50%;
    top: -28px;
    transform: translateX(-50%) scale(0.8);
    padding: 0.1rem 0.5rem;
    border-radius: 999px;
    font-size: 0.66rem;
    font-weight: 700;
    white-space: nowrap;
    color: var(--amber);
    background: color-mix(in srgb, var(--amber) 14%, transparent);
    opacity: 0;
    transition: opacity 0.3s, transform 0.4s var(--ease-spring);
  }
  .tick.show {
    opacity: 1;
    transform: translateX(-50%) scale(1);
  }
  .wire :global(.packet) {
    position: absolute;
    top: 50%;
    left: 0;
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    background: var(--grad);
    color: #fff;
    font-size: 0.66rem;
    font-weight: 700;
    white-space: nowrap;
    box-shadow: 0 6px 16px -6px var(--coral);
    transform: translate(0, -50%);
  }
  .lavalink {
    display: grid;
    justify-items: center;
    gap: 0.15rem;
    padding: 0.8rem 0.9rem;
    border-radius: 14px;
    border: 1px solid var(--border-strong);
    background: var(--surface-2);
    text-align: center;
  }
  .lavalink svg {
    width: 26px;
    fill: none;
    stroke: var(--mint);
    stroke-width: 1.8;
  }
  .lavalink strong {
    font-size: 0.85rem;
  }
  .lavalink span {
    font-size: 0.72rem;
    color: var(--faint);
    font-family: var(--mono);
    white-space: nowrap;
  }
  .payload {
    margin: 1.1rem 0 0;
    padding: 0.75rem 0.9rem;
    border-radius: 12px;
    border: 1px solid var(--border);
    background: color-mix(in srgb, var(--bg) 55%, var(--surface));
    font-family: var(--mono);
    font-size: 0.74rem;
    line-height: 1.55;
    color: var(--muted);
    overflow-x: auto;
    opacity: 0.3;
    filter: blur(1px);
    transition: opacity 0.5s, filter 0.5s;
  }
  .payload.show {
    opacity: 1;
    filter: none;
  }
  .counters {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.6rem;
    margin-top: 0.9rem;
  }
  .counters div {
    display: grid;
    padding: 0.7rem 0.9rem;
    border-radius: 12px;
    border: 1px solid var(--border);
    background: var(--surface-2);
  }
  .counters span {
    font-family: var(--display);
    font-size: 1.9rem;
    font-weight: 800;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .counters div:last-child span {
    background: var(--grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .counters small {
    color: var(--faint);
    font-size: 0.78rem;
  }
  @media (max-width: 900px) {
    .split {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 520px) {
    .lane {
      grid-template-columns: minmax(0, 1fr);
    }
    .wire {
      height: 40px;
      width: 2px;
      justify-self: center;
      background: repeating-linear-gradient(180deg, var(--border-strong) 0 6px, transparent 6px 12px);
    }
    .wire :global(.packet) {
      display: none;
    }
    .tick {
      top: 50%;
      left: 12px;
      transform: translateY(-50%);
    }
    .tick.show {
      transform: translateY(-50%);
    }
  }
</style>
