---
import { link } from '../../utils/links';

const fixes = [
  ['setVolume(100) sent 1000, ten times too loud', 'Volume 0-1000, where 100 is unchanged'],
  ['Idle nodes dropped after about 60 seconds', 'WebSocket pings keep idle nodes connected'],
  ['v3 Resume-Key header, so resuming never worked', 'Real v4 Session-Id resuming'],
  ['play() could run before the node had a session', 'Players only use nodes with a ready session'],
  ['Health check deleted nodes that were reconnecting', 'Backoff reconnects plus automatic failover'],
  ['A global NodeManager shared nodes between managers', 'Each Raya instance owns its nodes'],
];
---

<section class="section" id="lavaflow">
  <div class="container">
    <header class="section-head" data-reveal>
      <span class="eyebrow">From LavaFlow</span>
      <h2>Rebuilt, <span class="gradient-text">not just renamed</span></h2>
      <p>Raya started from LavaFlow's code and fixed what held it back.</p>
    </header>

    <div class="list">
      {
        fixes.map(([before, after], i) => (
          <div class="fix" data-reveal style={`--delay: ${i * 0.06}s`}>
            <div class="before">
              <span class="mark bad" aria-hidden="true">✕</span>
              <span class="sr-only">LavaFlow:</span>
              <s>{before}</s>
            </div>
            <svg class="arrow" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M4 12h16M14 6l6 6-6 6" />
            </svg>
            <div class="after">
              <span class="mark good" aria-hidden="true">✓</span>
              <span class="sr-only">Raya:</span>
              <span>{after}</span>
            </div>
          </div>
        ))
      }
    </div>

    <p class="cta" data-reveal>
      <a href={link('guides/migrating-from-lavaflow/')}>Read the migration guide →</a>
    </p>
  </div>
</section>

<style>
  .list {
    display: grid;
    gap: 10px;
    max-width: 920px;
    margin: 0 auto;
  }
  .fix {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    padding: 0.9rem 1.1rem;
    border-radius: 14px;
    border: 1px solid var(--border);
    background: var(--surface);
    transition: border-color 0.3s, transform 0.4s var(--ease-out);
  }
  .fix:hover {
    border-color: color-mix(in srgb, var(--mint) 40%, var(--border));
    transform: translateX(4px);
  }
  .before,
  .after {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.95rem;
  }
  .before s {
    color: var(--faint);
    text-decoration-color: color-mix(in srgb, var(--red) 70%, transparent);
    text-decoration-thickness: 1.5px;
  }
  .after span:last-child {
    font-weight: 500;
  }
  .mark {
    flex: none;
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    font-size: 0.7rem;
    font-weight: 800;
  }
  .bad {
    color: var(--red);
    background: color-mix(in srgb, var(--red) 13%, transparent);
  }
  .good {
    color: var(--mint);
    background: color-mix(in srgb, var(--mint) 15%, transparent);
  }
  .arrow {
    width: 20px;
    fill: none;
    stroke: var(--faint);
    stroke-width: 2;
    transition: transform 0.4s var(--ease-out), stroke 0.3s;
  }
  .fix:hover .arrow {
    stroke: var(--mint);
    transform: translateX(3px);
  }
  .cta {
    margin: 1.6rem 0 0;
    text-align: center;
  }
  .cta a {
    font-weight: 600;
    color: var(--coral);
  }
  @media (max-width: 720px) {
    .fix {
      grid-template-columns: 1fr;
      gap: 0.4rem;
    }
    .arrow {
      transform: rotate(90deg);
      justify-self: start;
      margin-left: 2px;
    }
    .fix:hover .arrow {
      transform: rotate(90deg);
    }
  }
</style>
