---
import { SITE } from '../../site.mjs';
import { link } from '../../utils/links';

const nav = [
  { label: 'Docs', href: link('getting-started/introduction/') },
  { label: 'Guides', href: link('guides/players/') },
  { label: 'Tools', href: link('tools/config-builder/') },
  { label: 'Reference', href: link('reference/raya/') },
  { label: 'Demo', href: '#demo' },
];
---

<header class="header" data-header>
  <div class="container bar">
    <a class="brand" href={link('/')} aria-label={`${SITE.name} home`}>
      <svg viewBox="0 0 64 64" aria-hidden="true">
        <defs>
          <linearGradient id="hdr-g" x1="6" y1="58" x2="58" y2="6" gradientUnits="userSpaceOnUse">
            <stop offset="0" stop-color="#ff4d8d" /><stop offset="0.5" stop-color="#ff7a45" /><stop offset="1" stop-color="#ffb547" />
          </linearGradient>
        </defs>
        <rect x="4" y="4" width="56" height="56" rx="16" fill="url(#hdr-g)" />
        <g fill="#fff" class="brand-bars">
          <rect x="15" y="27" width="5" height="10" rx="2.5" />
          <rect x="23.5" y="20" width="5" height="24" rx="2.5" />
          <rect x="32" y="14" width="5" height="36" rx="2.5" />
          <rect x="40.5" y="22" width="5" height="20" rx="2.5" />
        </g>
        <circle cx="47" cy="47" r="4" fill="#fff" fill-opacity="0.9" />
      </svg>
      <span>{SITE.name}</span>
      <span class="version">v{SITE.version}</span>
    </a>

    <nav class="nav" aria-label="Main" data-nav>
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <div class="actions">
      <a class="icon-btn" href={SITE.github} aria-label="GitHub repository" rel="noopener">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.33-1.29-1.69-1.29-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.71 1.26 3.37.96.1-.75.4-1.26.73-1.55-2.56-.29-5.25-1.28-5.25-5.69 0-1.26.45-2.28 1.18-3.09-.12-.29-.51-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.62 1.59.23 2.76.11 3.05.74.81 1.18 1.83 1.18 3.09 0 4.42-2.7 5.4-5.27 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z" /></svg>
      </a>
      <button class="icon-btn" type="button" data-theme-toggle aria-label="Toggle color theme">
        <svg class="sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.5" /><path d="M12 2v2.5M12 19.5V22M4.2 4.2l1.8 1.8M18 18l1.8 1.8M2 12h2.5M19.5 12H22M4.2 19.8 6 18M18 6l1.8-1.8" /></svg>
        <svg class="moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5a8.5 8.5 0 1 0 11 11Z" /></svg>
      </button>
      <a class="btn btn-primary cta" href={link('getting-started/quick-start/')}>Get started</a>
      <button class="icon-btn menu" type="button" aria-label="Open menu" aria-expanded="false" data-menu>
        <span></span><span></span>
      </button>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]')!;
  const onScroll = () => header.classList.toggle('scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
    document.documentElement.dataset.theme = next;
    try {
      localStorage.setItem('starlight-theme', next);
    } catch {
      /* private mode */
    }
  });

  const menu = document.querySelector<HTMLButtonElement>('[data-menu]')!;
  const closeMenu = () => {
    header.classList.remove('open');
    menu.setAttribute('aria-expanded', 'false');
  };
  menu.addEventListener('click', () => {
    const open = header.classList.toggle('open');
    menu.setAttribute('aria-expanded', String(open));
  });
  document.querySelectorAll('[data-nav] a').forEach((a) => a.addEventListener('click', closeMenu));
  document.addEventListener('keydown', (event) => event.key === 'Escape' && closeMenu());
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid transparent;
    transition: background 0.3s, border-color 0.3s, backdrop-filter 0.3s;
  }
  .header.scrolled,
  .header.open {
    background: color-mix(in srgb, var(--bg) 78%, transparent);
    backdrop-filter: blur(14px) saturate(140%);
    border-bottom-color: var(--border);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    height: 68px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--display);
    font-weight: 750;
    font-size: 1.3rem;
    letter-spacing: -0.02em;
  }
  .brand svg {
    width: 32px;
    height: 32px;
    transition: transform 0.4s var(--ease-spring);
  }
  .brand:hover svg {
    transform: rotate(-8deg) scale(1.06);
  }
  .brand-bars rect {
    transform-box: fill-box;
    transform-origin: center;
    animation: bounce 1.4s ease-in-out infinite;
  }
  .brand-bars rect:nth-child(2) {
    animation-delay: -0.3s;
  }
  .brand-bars rect:nth-child(3) {
    animation-delay: -0.6s;
  }
  .brand-bars rect:nth-child(4) {
    animation-delay: -0.9s;
  }
  @keyframes bounce {
    50% {
      transform: scaleY(0.55);
    }
  }
  .version {
    font-family: var(--mono);
    font-size: 0.7rem;
    font-weight: 500;
    padding: 0.12rem 0.45rem;
    border-radius: 999px;
    border: 1px solid var(--border-strong);
    color: var(--muted);
  }
  .nav {
    display: flex;
    gap: 0.2rem;
    margin-left: 0.5rem;
  }
  .nav a {
    position: relative;
    padding: 0.45rem 0.75rem;
    border-radius: 999px;
    color: var(--muted);
    font-size: 0.93rem;
    font-weight: 500;
    transition: color 0.2s, background 0.2s;
  }
  .nav a:hover {
    color: var(--text);
    background: var(--surface-2);
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-left: auto;
  }
  .icon-btn {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 999px;
    border: 1px solid transparent;
    background: transparent;
    color: var(--muted);
    transition: color 0.2s, background 0.2s, border-color 0.2s;
  }
  .icon-btn:hover {
    color: var(--text);
    background: var(--surface-2);
    border-color: var(--border);
  }
  .icon-btn svg {
    width: 19px;
    height: 19px;
    fill: currentColor;
  }
  .sun {
    fill: none !important;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
  }
  :global(:root[data-theme='dark']) .sun,
  :global(:root[data-theme='light']) .moon {
    display: none;
  }
  .cta {
    height: 40px;
    padding: 0 1rem;
    font-size: 0.88rem;
    margin-left: 0.3rem;
  }
  .menu {
    display: none;
  }
  .menu span {
    display: block;
    width: 18px;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
    transition: transform 0.3s var(--ease-out);
    grid-area: 1 / 1;
  }
  .menu span:first-child {
    transform: translateY(-3.5px);
  }
  .menu span:last-child {
    transform: translateY(3.5px);
  }
  .open .menu span:first-child {
    transform: rotate(45deg);
  }
  .open .menu span:last-child {
    transform: rotate(-45deg);
  }
  @media (max-width: 860px) {
    .menu {
      display: grid;
    }
    .cta {
      display: none;
    }
    .nav {
      position: absolute;
      top: 68px;
      left: 0;
      right: 0;
      flex-direction: column;
      gap: 0;
      margin: 0;
      padding: 0.5rem 20px 1rem;
      background: color-mix(in srgb, var(--bg) 94%, transparent);
      backdrop-filter: blur(14px);
      border-bottom: 1px solid var(--border);
      opacity: 0;
      transform: translateY(-8px);
      pointer-events: none;
      transition: opacity 0.25s, transform 0.25s var(--ease-out);
    }
    .nav a {
      padding: 0.8rem 0.5rem;
      border-radius: 10px;
      font-size: 1.05rem;
    }
    .open .nav {
      opacity: 1;
      transform: none;
      pointer-events: auto;
    }
  }
</style>
