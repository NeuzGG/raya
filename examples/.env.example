# Copy this file to examples/.env and fill in your own values.
# examples/.env is ignored by git, so your secrets stay on your computer.

DISCORD_TOKEN=your-bot-token-here

LAVALINK_HOST=localhost
LAVALINK_PORT=2333
LAVALINK_PASSWORD=youshallnotpass
LAVALINK_SECURE=false

# Set to 1 to print Raya debug logs
RAYA_DEBUG=0
